# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Load it in your shell before a run:   set -a; source .env; set +a

# Needed for the Claude arms (claude, claude_tools and claude_mcp plans).
ANTHROPIC_API_KEY=

# Optional. The user secret and the signing key already live in ~/.config/geobench/.
# Set these only to move them.
# GEOBENCH_CONFIG_DIR=
# GEOBENCH_USER_SECRET=

# Needed for the OpenAI probe (ADR-029, plans/probe-openai.yaml).
OPENAI_API_KEY=

# The VM name that plans read as $GEOBENCH_VM (pull_cmd). Never commit the real value.
# GEOBENCH_VM=
